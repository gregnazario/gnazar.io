{
	"name": "personal-website",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"format": "biome format . --write",
		"format:check": "biome format .",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug",
		"generate:icons": "node scripts/generate-icons.mjs",
		"generate:og": "node scripts/generate-og-image.mjs",
		"generate:og:posts": "node scripts/generate-post-og-images.mjs",
		"generate:screenshots": "node scripts/generate-screenshots.mjs",
		"generate:posters": "node scripts/generate-project-posters.mjs",
		"sync:stats": "node scripts/sync-project-stats.mjs",
		"generate:assets": "node scripts/generate-icons.mjs && node scripts/generate-og-image.mjs && node scripts/generate-screenshots.mjs && node scripts/generate-project-posters.mjs",
		"optimize:images": "node scripts/optimize-images.mjs",
		"translate": "node scripts/translate.mjs",
		"translate:force": "node scripts/translate.mjs --force",
		"new": "node scripts/new-content.mjs",
		"new:blog": "node scripts/new-content.mjs blog",
		"new:project": "node scripts/new-content.mjs project",
		"check-links": "node scripts/check-links.mjs",
		"validate": "node scripts/check-links.mjs",
		"prepare": "husky"
	},
	"dependencies": {
		"@tanstack/react-router": "^1.170.31",
		"@tanstack/react-start": "^1.168.48",
		"fuse.js": "^7.5.0",
		"gray-matter": "^4.0.3",
		"katex": "^0.18.4",
		"mermaid": "^11.17.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-katex": "^7.0.1",
		"rehype-raw": "^7.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@netlify/vite-plugin-tanstack-start": "^1.3.17",
		"@tanstack/router-plugin": "^1.168.34",
		"openai": "^7.5.0",
		"@playwright/test": "^1.62.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"@vitest/coverage-v8": "^4.1.11",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"lint-staged": "^17.3.0",
		"sharp": "^0.35.3",
		"typescript": "^5.9.3",
		"vite": "^8.2.1",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"tar": "^7.5.7",
		"h3": "^1.15.6",
		"ajv": "^8.18.0",
		"defu": "^6.1.5",
		"tmp": "^0.2.6",
		"svgo": "^4.0.1",
		"rollup": "^4.59.0",
		"uuid": "^13.0.1",
		"yaml": "^2.8.3",
		"postcss": "^8.5.23",
		"fast-uri": "^3.1.5",
		"@babel/core": "^7.29.1",
		"vitest>vite": "^8.2.1",
		"brace-expansion@^2.0.0": "^2.1.3",
		"minimatch@^9.0.0": "^9.0.6",
		"postcss>nanoid": "^3.3.16",
		"picomatch@<2.3.2": "^2.3.2"
	},
	"engines": {
		"node": ">=18.18.0"
	},
	"lint-staged": {
		"*.{js,ts,tsx,json,css,md}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
